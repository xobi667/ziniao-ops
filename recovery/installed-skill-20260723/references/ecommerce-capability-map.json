  "version": 1,
  "updated_at": "2026-07-06",
  "policy": {
    "default_scope": "employee-local_read_only_first",
    "install_policy": "Only local open components can be installed automatically. Closed SaaS, paid tools, browser extensions, API credentials, and MCP accounts require explicit user setup.",
    "privacy": "Do not upload store names, screenshots, seller reports, customer data, cookies, sessions, passwords, verification codes, or credentials to external tools unless the user explicitly asks and the account boundary is clear.",
    "write_actions": "Publishing products, changing prices, changing ad budgets, sending customer messages, refunds, payments, and settings changes require explicit user confirmation every time."
  },
  "support_levels": [
    {
      "id": "built_in",
      "meaning": "Included in ziniao-ops and usable after local setup."
    },
    {
      "id": "optional_detect_only",
      "meaning": "Recorded and health-checked, but not installed or used unless the user configures it."
    },
    {
      "id": "roadmap_read_only",
      "meaning": "Planned connector direction. Start with read-only data retrieval and normalized reports."
    },
    {
      "id": "manual_saas",
      "meaning": "Use through the vendor website/account. Do not bundle."
    }
  ],
